# Copy to .env. Never put real credentials in static/ or content/.
# Required on Render. Choose your own 12+ character demo access password.
DEMO_ACCESS_PASSWORD=
REQUIRE_ACCESS_PASSWORD=false
# Full OpenAI-compatible chat completions URL (not just the base URL).
LLM_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Official DeepSeek host uses thinking.type=disabled for low-latency voice.

# New speech console: API Key. ASR and TTS may have separate keys.
VOLC_ASR_API_KEY=
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# Old console alternative: set both fields; API_KEY takes precedence.
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=

VOLC_TTS_API_KEY=
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# Must match the resource/model family and your account's voice permission.
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLC_TTS_SAMPLE_RATE=24000
# Sally speech rate: 20 is approximately 1.2x; 0 restores normal speed. Supported range -50..100.
VOLC_TTS_SPEECH_RATE=20
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# Robin Li only: shared TTS credentials, independent preset voice/resource.
# Keep VOLC_TTS_SPEAKER unchanged for Sally.
ROBIN_TTS_SPEAKER=zh_male_m191_uranus_bigtts
ROBIN_TTS_RESOURCE_ID=seed-tts-2.0
# Robin speech rate: 20 is approximately 1.2x; 0 restores normal speed.
ROBIN_TTS_SPEECH_RATE=20

PROVIDER_TIMEOUT_SECONDS=45
MAX_AUDIO_SECONDS=60
# Local demo only. For a deliberate custom hostname, add it here.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional exact origins, e.g. https://demo.example.com; no wildcard.
ALLOWED_ORIGINS=
